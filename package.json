{
  "name": "ppug-yvr-agent-guardrails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "test -x node_modules/.bin/vite || npm install",
    "dev": "vite dev --port 3000 --host 0.0.0.0",
    "prestart": "test -x node_modules/.bin/vite || npm install",
    "start": "vite dev --port 3000 --host 0.0.0.0",
    "prebuild": "test -x node_modules/.bin/vite || npm install",
    "build": "vite build",
    "predeploy": "test -x node_modules/.bin/vite || npm install",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check": "oxfmt --check . && oxlint src/ test/ && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.30",
    "@ai-sdk/react": "4.0.149",
    "@cloudflare/ai-chat": "0.12.1",
    "@cloudflare/computer": "0.5.1",
    "@cloudflare/think": "0.21.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "agents": "0.29.0",
    "ai": "7.0.145",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.7.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "wrangler": "4.151.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
